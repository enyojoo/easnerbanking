{
  "expo": {
    "name": "Easner",
    "slug": "easner",
    "scheme": "easner",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "4",
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.easner.mobile",
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      },
      "associatedDomains": [
        "applinks:app.easner.com"
      ],
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "com.apple.developer.devicecheck.appattest-environment": "production",
        "com.apple.developer.in-app-payments": [
          "merchant.com.easner.mobile"
        ]
      }
    },
    "android": {
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icons/adaptive-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#007ACC",
        "monochromeImage": "./assets/icons/adaptive-icon.png"
      },
      "package": "com.easner.android",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.easner.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icons/easner-favicon.png",
      "name": "Easner Banking",
      "shortName": "Easner"
    },
    "extra": {
      "eas": {
        "projectId": "b1e3438a-faea-4359-a86f-6b279ebe2743"
      },
      "applePayMerchantId": "merchant.com.easner.mobile"
    },
    "androidStatusBar": {
      "backgroundColor": "#007ACC",
      "barStyle": "dark-content"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#007ACC",
          "image": "./assets/icons/adaptive-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-background-task",
      "expo-sharing",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.easner.mobile",
          "enableGooglePay": true,
          "includeOnramp": true
        }
      ]
    ],
    "owner": "easner"
  }
}
