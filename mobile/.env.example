# Same Supabase project as business + office.
# If unset, `app.config.js` loads ../business/.env.local (NEXT_PUBLIC_SUPABASE_*) for local dev.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Business Next.js API: Noah routes (/api/noah/*), auth bootstrap (/api/auth/bootstrap), etc.
# Required so mobile sign-up creates public.users the same way as the business app (Bearer + service role).
# Example: http://localhost:3000 (default `next dev`) or whatever port the business app uses
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Intercom: `app.config.js` uses the Expo config plugin with `useManualInit` (keys are not written into
# AppDelegate/MainApplication in source). At runtime, `intercomBootstrap.ts` calls `Intercom.initialize`
# then `loginUnidentifiedUser` + launcher visibility. Values below are embedded at build time via `extra`.
EXPO_PUBLIC_INTERCOM_APP_ID=
EXPO_PUBLIC_INTERCOM_IOS_API_KEY=
EXPO_PUBLIC_INTERCOM_ANDROID_API_KEY=
# US | EU | AU — workspace hosting region (matches Intercom dashboard URL).
EXPO_PUBLIC_INTERCOM_REGION=US
# Optional non-public names for CI only (same values; not bundled in JS): INTERCOM_APP_ID, INTERCOM_IOS_API_KEY, INTERCOM_ANDROID_API_KEY

# Payout corridor catalog (default on). Set to "false" for legacy static bank/MM lists only.
# EXPO_PUBLIC_USE_PAYOUT_CORRIDORS=false
