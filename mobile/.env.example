# Same Supabase project as business + office.
# If unset, `app.config.js` loads ../business/.env.local (NEXT_PUBLIC_SUPABASE_*) for local dev.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Business Next.js API: Noah routes (/api/noah/*), auth bootstrap (/api/auth/bootstrap), etc.
# Required so mobile sign-up creates public.users the same way as the business app (Bearer + service role).
# Example: http://localhost:3000 (default `next dev`) or whatever port the business app uses
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Intercom: `app.config.js` uses the Expo config plugin with `useManualInit` (keys are not written into
# AppDelegate/MainApplication in source). Runtime logic lives in `src/lib/intercom.ts` (init, JWT, Support → present).
# Values below are embedded at build time via `extra`.
EXPO_PUBLIC_INTERCOM_APP_ID=
EXPO_PUBLIC_INTERCOM_IOS_API_KEY=
EXPO_PUBLIC_INTERCOM_ANDROID_API_KEY=
# US | EU | AU — workspace hosting region (matches Intercom dashboard URL).
EXPO_PUBLIC_INTERCOM_REGION=US
# Optional non-public names for CI only (same values; not bundled in JS): INTERCOM_APP_ID, INTERCOM_IOS_API_KEY, INTERCOM_ANDROID_API_KEY

# Android push (native rebuild required). Default: mobile/google-services.json if present.
# EXPO_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# Sign in with Apple
# iOS (native rebuild): App ID com.easner.mobile + Supabase Auth → Apple → Client IDs includes com.easner.mobile
# Expo web (Apple JS, no OAuth secret):
# 1. Apple Developer → Identifiers → Services IDs → create com.easner.mobile.web (Sign in with Apple on)
# 2. Website URLs: domain app.easner.com, return URL https://app.easner.com/auth/callback (exact, no slash)
# 3. Supabase Auth → Apple → Client IDs: add com.easner.mobile.web (NOT the bundle ID alone)
# Defaults to com.easner.mobile.web if unset. Override only if your Services ID differs:
EXPO_PUBLIC_APPLE_WEB_CLIENT_ID=com.easner.mobile.web
# Optional: force redirect when testing a non-production host (must match Apple return URL list)
# EXPO_PUBLIC_APPLE_WEB_REDIRECT_URI=https://app.easner.com/auth/callback
