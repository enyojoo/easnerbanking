# Same Supabase project as business + office.
# If unset, `app.config.js` loads ../business/.env.local (NEXT_PUBLIC_SUPABASE_*) for local dev.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Business Next.js API: Noah routes (/api/noah/*), auth bootstrap (/api/auth/bootstrap), etc.
# Required so mobile sign-up creates public.users the same way as the business app (Bearer + service role).
# Example: http://localhost:3000 (default `next dev`) or whatever port the business app uses
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_INTERCOM_APP_ID=your_app_id
EXPO_PUBLIC_INTERCOM_IOS_API_KEY=ios_sdk-your_ios_key
EXPO_PUBLIC_INTERCOM_ANDROID_API_KEY=android_sdk-your_android_key
# US | EU | AU — must match where your Intercom *workspace* is hosted (native SDK; needs prebuild + rebuild).
# How to tell: the URL when you open Intercom in a browser:
#   app.intercom.com        → US
#   app.eu.intercom.com     → EU
#   app.au.intercom.com     → AU
# You can use eu / us / ap (ap→AU) or uppercase. EAS: set EXPO_PUBLIC_INTERCOM_REGION (or align NEXT_PUBLIC_INTERCOM_REGION in business — we alias it in app.config.js).
EXPO_PUBLIC_INTERCOM_REGION=US
#
# Messenger Security (JWT): the app calls GET `${EXPO_PUBLIC_API_URL}/api/intercom/jwt` with the
# Supabase access token. Minting requires `INTERCOM_MESSENGER_API_SECRET` on that Next.js server
# (same secret as web). No secret in the mobile bundle.

# EAS Build: the Intercom config plugin can also read non-public names (not in the app JS bundle):
# INTERCOM_APP_ID, INTERCOM_IOS_API_KEY, INTERCOM_ANDROID_API_KEY — see alias in app.config.js

# Payout corridor catalog (default on). Set to "false" for legacy static bank/MM lists only.
# EXPO_PUBLIC_USE_PAYOUT_CORRIDORS=false

