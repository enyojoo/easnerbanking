{
  "name": "easner-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/linkWorkspaceDeps.js",
    "eas-build-pre-install": "cd .. && npm install && cd mobile && node scripts/linkWorkspaceDeps.js",
    "eas-build-post-install": "node scripts/linkWorkspaceDeps.js && node scripts/syncHoistedScope.js @supabase",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "npx eas-cli build --platform android",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "build:ios": "npx eas-cli build --platform ios",
    "build:all": "npx eas-cli build --platform all",
    "submit:android": "npx eas-cli submit --platform android",
    "submit:ios": "npx eas-cli submit --platform ios"
  },
  "dependencies": {
    "@easner/shared": "*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.57.2",
    "@tanstack/query-async-storage-persister": "^5.99.1",
    "@tanstack/react-query": "^5.99.1",
    "@tanstack/react-query-persist-client": "^5.99.1",
    "expo": "~54.0.29",
    "expo-auth-session": "~7.0.10",
    "expo-background-task": "~1.0.10",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "^14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-notifications": "~0.32.15",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.555.0",
    "posthog-react-native": "^4.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-quick-base64": "^2.2.2",
    "react-native-quick-crypto": "0.7.17",
