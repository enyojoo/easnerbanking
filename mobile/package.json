{
  "name": "easner-mobile",
  "version": "1.10.3",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node -e \"if(process.env.EAS_BUILD!=='true'){require('child_process').execSync('node scripts/linkWorkspaceDeps.js',{stdio:'inherit'})}\"",
    "eas-build-pre-install": "cd .. && npm ci --ignore-scripts --workspace=easner-mobile --workspace=@easner/shared --include-workspace-root",
    "eas-build-post-install": "cd .. && node scripts/postinstall-patch-package.mjs && cd mobile && node scripts/linkWorkspaceDeps.js && node scripts/syncHoistedScope.js @supabase",
    "start": "node scripts/expo-cli.cjs start",
    "android": "node scripts/expo-cli.cjs run:android",
    "ios": "node scripts/expo-cli.cjs run:ios",
    "web": "node scripts/expo-cli.cjs start --web",
    "build:web": "node scripts/expo-cli.cjs export --platform web",
    "prebuild": "node scripts/expo-cli.cjs prebuild",
    "build:android": "npx eas-cli build --platform android",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "build:ios": "npx eas-cli build --platform ios",
    "build:all": "npx eas-cli build --platform all",
    "submit:android": "npx eas-cli submit --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "lint:theme": "node scripts/check-mobile-theme-literals.mjs",
    "test": "jest"
  },
  "dependencies": {
    "@easner/shared": "*",
    "@expo/metro-runtime": "~57.0.12",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@intercom/intercom-react-native": "^10.2.0",
    "@intercom/messenger-js-sdk": "^0.0.19",
    "@noble/hashes": "1.8.0",
    "@posthog/react-native-plugin": "2.8.0",
