{
  "name": "easner-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node -e \"if(process.env.EAS_BUILD!=='true'){require('child_process').execSync('node scripts/linkWorkspaceDeps.js',{stdio:'inherit'})}\"",
    "eas-build-pre-install": "cd .. && npm ci --ignore-scripts --workspace=easner-mobile --workspace=@easner/shared --include-workspace-root",
    "eas-build-post-install": "cd .. && npx patch-package && cd mobile && node scripts/linkWorkspaceDeps.js && node scripts/syncHoistedScope.js @supabase",
    "start": "node scripts/expo-cli.cjs start",
    "android": "node scripts/expo-cli.cjs run:android",
    "ios": "node scripts/expo-cli.cjs run:ios",
    "web": "node scripts/expo-cli.cjs start --web",
    "prebuild": "node scripts/expo-cli.cjs prebuild",
    "build:android": "npx eas-cli build --platform android",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "build:ios": "npx eas-cli build --platform ios",
    "build:all": "npx eas-cli build --platform all",
    "submit:android": "npx eas-cli submit --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "lint:theme": "node scripts/check-mobile-theme-literals.mjs",
    "test": "jest"
  },
  "dependencies": {
    "@easner/shared": "*",
    "@expo/metro-runtime": "~56.0.13",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@intercom/intercom-react-native": "10.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.57.2",
    "@tanstack/query-async-storage-persister": "^5.99.1",
    "@tanstack/react-query": "^5.99.1",
    "@tanstack/react-query-persist-client": "^5.99.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~56.0.5",
    "expo-auth-session": "~56.0.12",
    "expo-background-task": "~56.0.15",
    "expo-blur": "~56.0.3",
    "expo-camera": "~56.0.7",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-crypto": "56.0.3",
    "expo-dev-client": "~56.0.16",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.6",
    "expo-image-manipulator": "~56.0.15",
    "expo-image-picker": "~56.0.14",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.12",
    "expo-notifications": "~56.0.14",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.14",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.15",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^0.555.0",
    "posthog-react-native": "^4.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-quick-base64": "^3.0.0",
    "react-native-quick-crypto": "0.7.17",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.85.3",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~56.0.4",
    "baseline-browser-mapping": "^2.9.19",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "react-refresh": "^0.14.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-image"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
