    "babel-preset-expo": "^54.0.1",
    "baseline-browser-mapping": "^2.9.19",
    "react-refresh": "^0.14.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
