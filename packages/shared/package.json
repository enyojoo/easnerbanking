{
  "name": "@easner/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./verified-identity": {
      "import": "./src/verified-identity.ts",
      "require": "./src/verified-identity.ts",
      "types": "./src/verified-identity.ts"
    },
    "./solana/address-format": {
      "import": "./src/solana/address-format.ts",
      "require": "./src/solana/address-format.ts",
      "types": "./src/solana/address-format.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "sync:flags": "node scripts/sync-flags.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "expo-image": ">=3",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": false
    },
    "expo-image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18",
    "sharp": "^0.34.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
