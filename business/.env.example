# Easner Business (Next.js) env example
#
# Copy to `.env.local` for local dev. Do not commit secrets.

## Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

## Supabase (server)
SUPABASE_SERVICE_ROLE_KEY=

## Noah
NOAH_API_KEY=
NOAH_API_BASE_URL=
NOAH_SIGNING_PRIVATE_KEY=
NOAH_ONBOARDING_RETURN_URL=
NOAH_BUSINESS_ONBOARDING_RETURN_URL=

## Turnkey
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_API_KEY_CURVE=API_KEY_CURVE_P256
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_BALANCE_CAIP2=solana:mainnet
TURNKEY_ONCHAIN_BALANCE_QUERY=true
TURNKEY_WALLET_AUTOPROVISION_ENABLED=true
TURNKEY_WEBHOOK_SECRET=
TURNKEY_FALLBACK_SUB_ORGAN_ID=

# Gas Sponsorship (Solana)
# Requires Turnkey dashboard: Gas Sponsorship enabled + (recommended) Sponsor Solana Rent enabled.
TURNKEY_SOL_SPONSORSHIP_ENABLED=true
# Optional override; if unset, we reuse TURNKEY_BALANCE_CAIP2.
TURNKEY_SOLANA_CAIP2=solana:mainnet
# After solSendTransaction, poll getSendTransactionStatus until terminal state (default 90s, 500ms interval).
# TURNKEY_SOL_SEND_POLL_TIMEOUT_MS=90000
# TURNKEY_SOL_SEND_POLL_INTERVAL_MS=500

## Internal workers
EASNER_INTERNAL_CRON_SECRET=
CRON_SECRET=

## Payroll V2 (server-only; never prefix these with NEXT_PUBLIC_)
# Generate once with: openssl rand -base64 32
# Keep this value stable. Changing it makes previously encrypted employee payout
# methods unreadable unless a key-rotation migration is implemented.
PAYROLL_DATA_ENCRYPTION_KEY=
# --- Vercel / production ---
# Set the same NEXT_PUBLIC_* and SUPABASE_* values in Vercel → Environment Variables
# (Production + Preview). Redeploy after changing them. In Supabase → Auth → URL Configuration,
# add this deployment’s origin (e.g. https://easnerbank.vercel.app) to Site URL and Redirect URLs.
# Use one canonical URL for the app so the session is not split across domains.

# --- CORS (Easner Office on a different host than this API) ---
# Defaults include localhost:3002 and https://easnerbanking-office.vercel.app – add more via env if needed.
#   EASNER_OFFICE_ORIGIN=https://another-office.example.com
#   CORS_ALLOWED_ORIGINS=https://office-preview.vercel.app,https://staging.example.com
# Office must set NEXT_PUBLIC_API_URL to this deployment (e.g. https://easnerbank.vercel.app).

NEXT_PUBLIC_SUPABASE_URL=https://kixymrjsupzkxokujmwu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FgqL2r3ZtCoGevLdLnbp6g_fcKNZ-EY
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

## Intercom Messenger (business web)
# Required for the in-app widget (client bundle). Set on Vercel for Production and Preview, then redeploy.
# Use the same `app_id` as your Intercom workspace (e.g. tw0a91fq). Not a secret, but must be present at `next build`.
# NEXT_PUBLIC_INTERCOM_APP_ID=
# Optional alias if you mistyped: NEXT_PUBLIC_INTERCOM_APPID=
# Optional: us | eu | ap (default us). Maps AU → ap.
# NEXT_PUBLIC_INTERCOM_REGION=us
#
# Messenger Security (JWT) – server-only. Intercom → Settings → Channels → Messenger → Security.
# Sign tokens with this secret on the server; never expose it to the client or NEXT_PUBLIC_*.
# Without it, the app falls back to the legacy (unsecured) boot until you set this and redeploy.
# INTERCOM_MESSENGER_API_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NOAH_API_KEY=
NOAH_SIGNING_PRIVATE_KEY=
NOAH_API_BASE_URL=https://api.sandbox.noah.com/v1
NOAH_ONBOARDING_RETURN_URL=https://easnerbank.vercel.app/auth/noah-kyb-return
NOAH_BUSINESS_ONBOARDING_RETURN_URL=https://easnerbank.vercel.app/auth/noah-kyb-return
NOAH_WEBHOOK_NOAH_ENV=sandbox
NEXT_PUBLIC_MOBILE_APP_HOME_URL=https://easner.com/user/dashboard
EASNER_OFFICE_ORIGIN=https://easner-office.vercel.app

# Payout corridor catalog (default on). Set to "false" to use legacy static country lists in the UI.
# NEXT_PUBLIC_USE_PAYOUT_CORRIDORS=false

# Turnkey (parent org API keys – see docs/turnkey-noah-flows-setup.md)
# TURNKEY_ORGANIZATION_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# Solana network for Turnkey getWalletAddressBalances – must match where deposit USDC/EURC were sent.
# Default solana:mainnet. For devnet: solana:devnet
# TURNKEY_BALANCE_CAIP2=solana:mainnet
# If createSubOrganization fails on the provisioner user, match dashboard key curve (default P256).
# TURNKEY_API_KEY_CURVE=API_KEY_CURVE_P256
# Set to "false" to disable server-side createSubOrganization on auth bootstrap (embedded / manual provision only).
# TURNKEY_SERVER_SUB_ORG_CREATION_ENABLED=true
# Wallet provisioning worker (cron). Vercel: set CRON_SECRET to the same value for Bearer auth on scheduled GETs.
# EASNER_INTERNAL_CRON_SECRET=

# Platform fee + YC cross-border refund destination (also a real org vault — unmatched USDC still books a Stablecoin deposit).
# WALLET_SEND_FEE_SOLANA_ADDRESS_USD=
# WALLET_SEND_FEE_SOLANA_ADDRESS_EUR=
# Extra Grid VA sweep source pubkeys (comma-separated). Known prod treasuries are already in code.
# GRID_VA_SWEEP_SOLANA_SOURCE_ADDRESSES=

## Stripe (invoice Pay online – platform MoR + Connect destination charges)
## Enabled automatically when STRIPE_SECRET_KEY + publishable key are set.
## Connect onboarding + destination charges are built-in (no extra flags).
## Enable "Listen to events on Connected accounts" on the same webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode Checkout (easner_pk_test_ / 4242). Same Stripe account → Developers → API keys → Test mode.
# Also add this URL as a Test-mode webhook endpoint and paste its signing secret.
# STRIPE_TEST_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# Optional kill-switch only (default: on when keys present)
# STRIPE_INVOICE_PAYMENTS_ENABLED=false
# Sandbox: map Easner business UUID → pre-created Connect account (Dashboard/manual onboarding)
# STRIPE_CONNECT_ACCOUNT_BY_BUSINESS_ID={"your-business-uuid":"acct_1U0lP62HmMI15xIx"}
