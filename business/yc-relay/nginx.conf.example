# TLS front for yc-relay — adjust server_name and cert paths.
server {
    listen 443 ssl http2;
    server_name yc-relay.easner.com;

    ssl_certificate     /etc/letsencrypt/live/yc-relay.easner.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yc-relay.easner.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }
}
