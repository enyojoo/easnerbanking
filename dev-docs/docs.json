{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Easner",
  "description": "Stablecoin-native banking and payments. Hold, receive, send, and collect through the Easner API.",
  "colors": {
    "primary": "#007ACC",
    "light": "#3AA6F8",
    "dark": "#0062A3"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.png",
    "href": "https://www.easner.com"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#F8F6F0",
      "dark": "#0F1110"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "what-is-easner",
          "capabilities",
          "quickstart",
          "authentication",
          "test-and-live"
        ]
      },
      {
        "group": "Banking",
        "pages": [
          "customers",
          "accounts",
          "receive",
          "send",
          "payment-methods",
          "destinations",
          "quotes",
          "transfers"
        ]
      },
      {
        "group": "Checkout",
        "pages": ["checkout"]
      },
      {
        "group": "API",
        "pages": ["reference", "transactions", "webhooks", "errors"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.easner.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://business.easner.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/easnerbanking",
      "linkedin": "https://linkedin.com/company/easner"
    },
    "links": [
      [
        {
          "label": "Terms",
          "href": "https://www.easner.com/terms"
        }
      ]
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.easner.com",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor"]
  }
}
