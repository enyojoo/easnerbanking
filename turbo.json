{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CRON_SECRET",
    "EASNER_INTERNAL_CRON_SECRET",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NOAH_API_BASE_URL",
    "NOAH_API_KEY",
    "NOAH_ONBOARDING_RETURN_URL",
    "NOAH_BUSINESS_ONBOARDING_RETURN_URL",
    "SENDGRID_API_KEY",
    "SENDGRID_FROM_EMAIL",
    "SENDGRID_FROM_NAME",
    "EASNER_OFFICE_ORIGIN",
    "NOAH_WEBHOOK_NOAH_ENV",
    "TURNKEY_API_KEY_CURVE",
    "TURNKEY_API_PRIVATE_KEY",
    "TURNKEY_API_PUBLIC_KEY",
    "TURNKEY_ORG_ID",
    "TURNKEY_ORGANIZATION_ID",
    "TURNKEY_WEBHOOK_SECRET",
    "TURNKEY_SERVER_SUB_ORG_CREATION_ENABLED",
    "TURNKEY_WALLET_AUTOPROVISION_ENABLED",
    "TURNKEY_BALANCE_CAIP2",
    "OPEN_EXCHANGE_RATES_APP_ID",
    "OPEN_EXCHANGE_RATES_TTL_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
