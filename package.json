{
  "name": "easner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*",
    "website",
    "web",
    "business",
    "office",
    "mobile"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:website": "turbo run dev --filter=website",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "npm run start --workspace=easner-mobile",
    "dev:all": "turbo run dev --filter=website --filter=web",
    "build": "turbo run build",
    "build:website": "turbo run build --filter=website",
    "build:web": "turbo run build --filter=web",
    "build:shared": "turbo run build --filter=@easner/shared",
    "lint": "turbo run lint",
    "start:website": "turbo run start --filter=website",
    "start:web": "turbo run start --filter=web",
    "dev:office": "turbo run dev --filter=office",
    "build:office": "turbo run build --filter=office",
    "start:office": "turbo run start --filter=office",
    "dev:business": "turbo run dev --filter=easner-business",
    "build:business": "turbo run build --filter=easner-business",
    "start:business": "turbo run start --filter=easner-business",
    "test:login-pin-vectors": "node scripts/login-pin-test-vectors.mjs",
    "test:server": "npm run test --workspace=@easner/server",
    "email:preview-all": "npx tsx packages/server/scripts/send-all-email-previews.ts",
    "email:render-supabase-auth": "npx tsx packages/server/scripts/render-supabase-auth-templates.ts",
    "sync:flags": "npm run sync:flags --workspace=@easner/shared",
    "postinstall": "node scripts/postinstall-patch-package.mjs"
  },
  "devDependencies": {
    "turbo": "^2.8.12"
  },
  "dependencies": {
    "@react-native/normalize-colors": "0.86.3",
    "expo-constants": "57.0.16",
    "expo-modules-core": "57.0.14",
    "expo-modules-jsi": "57.0.6",
    "next": "^16.1.6",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-slot": "1.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "glob": "^13.0.6",
    "rimraf": "^5.0.10",
    "react-native-quick-base64": "3.0.0",
    "@react-native/normalize-colors": "0.86.3",
    "expo": "57.0.18",
    "expo-constants": "57.0.16",
    "expo-asset": {
      ".": "~57.0.15",
      "expo-constants": "~57.0.16"
    },
    "react-native": "0.86.3",
    "@expo/metro-runtime": "57.0.14",
    "jest-expo": "57.0.5",
    "expo-auth-session": {
      ".": "~57.0.10",
      "expo-application": "~57.0.2",
      "expo-constants": "~57.0.16",
      "expo-crypto": "~57.0.2",
      "expo-linking": "~57.0.8",
      "expo-web-browser": "~57.0.2"
    },
    "expo-linking": {
      ".": "~57.0.8",
      "expo-constants": "~57.0.16"
    },
    "easner-mobile": {
      "expo": "~57.0.18",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.86.3",
      "expo-asset": "~57.0.15",
      "expo-auth-session": "~57.0.10",
      "expo-background-task": "~57.0.14",
      "expo-keep-awake": "~57.0.1",
      "expo-dev-client": "~57.0.16",
      "expo-image": "~57.0.3",
      "expo-image-manipulator": "~57.0.14",
      "expo-image-picker": "~57.0.14",
      "expo-linking": "~57.0.8",
      "expo-media-library": "~57.0.4",
      "expo-sharing": "~57.0.16",
      "expo-splash-screen": "~57.0.8",
      "expo-task-manager": "~57.0.14"
    },
    "jayson": {
      "uuid": "11.1.0"
    },
    "uuid@8.3.2": "11.1.0"
  },
  "allowScripts": {
    "bigint-buffer@1.1.5": true,
    "bufferutil@4.1.0": true,
    "core-js@3.49.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@6.0.6": true
  }
}
